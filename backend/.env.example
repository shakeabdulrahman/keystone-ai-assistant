# Copy to .env for local development. Never commit .env.
APP_ENV=local
LOG_LEVEL=INFO
# Local Docker Postgres (docker-compose.yml). Use a managed URL in deployment.
DATABASE_URL=postgresql+asyncpg://keystone:keystone@localhost:5432/keystone
# Auth: dev (fake "dev:<user>" tokens, local only) | firebase (real sign-in; needs the project ID)
AUTH_MODE=dev
FIREBASE_PROJECT_ID=
# AI provider: fake (scripted, no AI needed) | ollama (local model) | gemini (cloud, free key)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
# When running the backend directly on your Mac (not in Docker):
OLLAMA_BASE_URL=http://localhost:11434
# Docker Compose overrides OLLAMA_BASE_URL to http://host.docker.internal:11434
# Gemini (used by the cloud deployment): free key from https://aistudio.google.com/apikey
# Free-tier prompts may be used by Google to improve its products: demo data only.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Only for models that support a thinking budget (older 2.5 models); leave unset otherwise.
# GEMINI_THINKING_BUDGET=0
# Policy search (RAG) embeddings: ollama (nomic-embed-text; run `ollama pull nomic-embed-text`)
# | gemini | hashing (offline, no model). Unset = same as LLM_PROVIDER (fake → hashing).
# EMBEDDING_PROVIDER=ollama
# Relevance floor for vector matches; tune with `uv run python -m app.rag.eval`.
# RAG_MIN_SIMILARITY=0.5
# Push notifications: path *inside the container* to the Firebase service-account key.
# Put the downloaded key at backend/secrets/firebase-service-account.json, then:
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/keystone/firebase-service-account.json
# Demo "manager" approves submitted leave after N seconds (0 = off).
# DEMO_WORKFLOW_DELAY_S=20

# --- Phase 8: protection and monitoring --------------------------------------------
# Rate limits (per minute). Set RATE_LIMIT_ENABLED=false only for load tests.
# RATE_CHAT_PER_MINUTE=12
# RATE_CHAT_BURST=5
# RATE_ACTIONS_PER_MINUTE=20
# RATE_USER_PER_MINUTE=120
# RATE_IP_PER_MINUTE=300
# Proxies in front of the app that append X-Forwarded-For (Render: 1; local: 0).
# TRUSTED_PROXY_HOPS=0
# MAX_REQUEST_BODY_BYTES=65536
# Firebase App Check: off | monitor (log failures) | enforce (reject). Needs the project
# NUMBER (Firebase console → Project settings → General).
# APP_CHECK_MODE=off
# FIREBASE_PROJECT_NUMBER=
# APP_CHECK_APP_IDS=
# Bearer token for GET /metrics (unset = endpoint disabled). Compose sets a local one.
# METRICS_TOKEN=
