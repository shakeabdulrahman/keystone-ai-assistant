# Copy to .env for local development. Never commit .env.
APP_ENV=local
LOG_LEVEL=INFO
# Local Docker Postgres (docker-compose.yml). Use a managed URL in deployment.
DATABASE_URL=postgresql+asyncpg://keystone:keystone@localhost:5432/keystone
# Auth: dev (fake "dev:<user>" tokens, local only) | firebase (real sign-in; needs the project ID)
AUTH_MODE=dev
FIREBASE_PROJECT_ID=
# AI provider: fake (scripted, no AI needed) | ollama (local model) | gemini | groq (later phases)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
# When running the backend directly on your Mac (not in Docker):
OLLAMA_BASE_URL=http://localhost:11434
# Docker Compose overrides OLLAMA_BASE_URL to http://host.docker.internal:11434
# Policy search (RAG) embeddings: ollama (nomic-embed-text; run `ollama pull nomic-embed-text`)
# | hashing (offline, no model). Unset = same as LLM_PROVIDER (ollama → ollama, fake → hashing).
# EMBEDDING_PROVIDER=ollama
# Relevance floor for vector matches; tune with `uv run python -m app.rag.eval`.
# RAG_MIN_SIMILARITY=0.5
